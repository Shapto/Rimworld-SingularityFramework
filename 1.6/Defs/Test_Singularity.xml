<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Dash, dash, jump slam: tests the chain, dash job, glide, preview line and landing slam -->
  <AbilityDef>
    <defName>Sing_Test_Chain</defName>
    <label>test chain</label>
    <description>Dash, dash, slam.</description>
    <iconPath>UI/Commands/Draft</iconPath>
    <verbProperties>
      <verbClass>SingularityFramework.Sequences.Verb_CastAbilityLineDash</verbClass>
      <range>8</range>
      <warmupTime>0.2</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="SingularityFramework.Sequences.CompProperties_AbilityLineDash">
        <dashJob>Sing_LineDash</dashJob>
        <strikeSettings>
          <damageDefinition>Cut</damageDefinition>
          <damageAmount>10</damageAmount>
        </strikeSettings>
      </li>
      <li Class="SingularityFramework.Sequences.CompProperties_AbilityJumpSlam">
        <flyerDefinition>Sing_Test_SlamFlyer</flyerDefinition>
      </li>
      <!-- Must stay last -->
      <li Class="SingularityFramework.Sequences.CompProperties_AbilityChain">
        <cooldownAfterFinalStageTicks>600</cooldownAfterFinalStageTicks>
      </li>
    </comps>
  </AbilityDef>

  <!-- A standalone jump slam: tests the comp without a chain -->
  <AbilityDef>
    <defName>Sing_Test_Jump</defName>
    <label>test jump</label>
    <description>Jump and slam.</description>
    <iconPath>UI/Commands/Draft</iconPath>
    <cooldownTicksRange>300</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>10</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="SingularityFramework.Sequences.CompProperties_AbilityJumpSlam">
        <flyerDefinition>Sing_Test_SlamFlyer</flyerDefinition>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="PawnFlyerBase">
  <defName>Sing_Test_SlamFlyer</defName>
  <thingClass>SingularityFramework.Sequences.PawnFlyer_LandingSlam</thingClass>
  <modExtensions>
    <li Class="SingularityFramework.Sequences.ModExtension_LandingSlam">
      <damageDefinition>Bomb</damageDefinition>
      <damageAmount>15</damageAmount>
      <radius>2.9</radius>
    </li>
  </modExtensions>
  </ThingDef>
</Defs>